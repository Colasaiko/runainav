list\"},\"connectButton\":\"Connect to Zoom\",\"maybeLaterButton\":\"Maybe Later\",\"skipModal\":{\"title\":\"Skipping this means no automatic notes\",\"description\":\"Otter won't be able to join your Zoom meetings or take notes. Connect Zoom now to automatically capture and summarize every meeting.\",\"skipButton\":\"Skip for now\",\"connectButton\":\"Connect Zoom\"},\"whyIsThisRequired\":\"Why is this required?\",\"tooltipCaption\":\"To automatically record Zoom meetings, Otter needs permission to join them. You can disconnect at any time in Otter settings.\"},\"welcome:video-demo\":{\"title\":\"Video Demo\",\"backButton\":\"Back\",\"goToSummaries\":\"Summaries\",\"backToRecording\":\"Recording\",\"goToAiChat\":\"AI Chat\",\"backToSummaries\":\"Summaries\",\"nextButton\":\"Next\"},\"welcome:sales-crm-connect\":{\"title\":\"Sync sales notes to your CRM\",\"description\":\"Boost sales productivity by automatically pushing AI notes to HubSpot or Salesforce.\",\"hubspot\":\"HubSpot\",\"salesforce\":\"Salesforce\",\"skip\":\"Skip\"},\"left-nav-bar\":{\"a11yNavLabel\":\"Main navigation\",\"home\":\"Home\",\"otterChat\":\"Otter AI Chat\",\"integrations\":\"Integrations\",\"channels\":\"Channels\",\"directMessages\":\"Direct Messages\",\"folders\":\"Folders\",\"transcriptionStatus\":{\"allCompleted\":\"All transcriptions completed\",\"transcribing\":\"Transcribing {count, plural, =1 {1 file} other {# files}}\",\"timeRemaining\":\"{hours, plural, =0 {{minutes}m left} other {#h{minutes}m left}}\"},\"usageCta\":{\"minutesWillResetIn\":\"Minutes will reset in \u003cremainingDays\u003e{days, plural, =1 {# day} other {# days}}\u003c/remainingDays\u003e\",\"monthlyMinsUsed\":\"\u003cbold\u003e{minutesUsed} of {quotaMinutes}\u003c/bold\u003e monthly mins used\",\"monthlyMinutesUsedWithReset\":\"{minutesUsed} of {quotaMinutes} monthly minutes used. Minutes reset in {remainingDays} {remainingDays, plural, =1 {day} other {days}}\",\"numberOfDays\":\"{count, plural, =1 {day} other {