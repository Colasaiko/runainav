ption\":\"Automatically share all channel members' external meetings\",\"autoshareMyMeetings\":\"Auto-share my external meetings to this channel\",\"autoshareMyMeetingsDescription\":\"When recording calendar events with external guests, automatically share my notes to this channel.\"},\"renameModal\":{\"title\":\"Rename this Channel\",\"channelNameLabel\":\"Channel name\"},\"leaveDialog\":{\"title\":\"Leave Channel?\",\"leave\":\"Leave\",\"cancel\":\"Cancel\",\"description\":\"This channel and any content within will no longer be visible.\"},\"joinChannel\":{\"joinChannel\":\"Join Channel\"},\"deleteDialog\":{\"title\":\"Delete Channel?\",\"delete\":\"Delete\",\"cancel\":\"Cancel\",\"description\":\"This channel and any content within will no longer be visible to any member.\"},\"viewError\":{\"title\":\"Hmm... this channel isn't available\",\"description\":\"This link might be broken, or you may not have permission to view it.\"},\"informationModal\":{\"addMember\":\"+ Add Member\"},\"inviteModal\":{\"title\":\"Add channel members\",\"description\":\"Invite others to the channel\",\"invite\":\"Invite\",\"cancel\":\"Cancel\",\"placeholder\":\"Type email addresses here\",\"ariaLabel\":\"Add users by email address\",\"fieldDescription\":\"Enter one or more email addresses, separated by a comma or space, and then press Return or Enter.\",\"externalUserSingle\":\"This user is not in your workspace and will be able to view content in this channel\",\"externalUserPlural\":\"Some users are not in your workspace and will be able to view content in this channel\"},\"memberList\":{\"makeChannelOwner\":\"Make channel owner\",\"removeMember\":\"Remove member\",\"you\":\"(You)\",\"deactivated\":\"(Deactivated)\",\"owner\":\"Owner\",\"invitedUser\":\"Invited user\",\"externalUser\":\"External user\",\"moreAriaLabel\":\"more\",\"autoSharingToChannel\":\"Auto sharing to channel\"},\"discoverabilityModal\":{\"changeToPrivateTitle\":\"Change to a private channel?\",\"changeToPublicTi