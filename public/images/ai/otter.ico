r\",\"minutes\":\"{count} minutes\",\"minutesPerUser\":\"{count} minutes per user\",\"hours\":\"{count} hours\",\"mostRecent\":\"{count} most recent\",\"terms\":\"{count} terms\",\"lifetimePerUser\":\"{count} lifetime per user\",\"monthlyPerUser\":\"{count} monthly per user\",\"perUser\":\"{count} per user\",\"perConversation\":\"{count} per conversation\",\"perUserAndConversation\":\"{userCount} per user\\n({conversationCount} per conversation)\",\"customVocabNumbers\":\"Team:\\n{numNames} names + {numTerms} other terms\\nUser:\\n{numUserNames} terms + {numUserTerms} other terms\",\"mp3_txt\":\"mp3, txt\",\"mp3_text_pdf_docx_srt\":\"mp3, txt, pdf, docx, srt\",\"mp3_text_pdf_docx_srt_bulk_export\":\"mp3, txt, pdf, docx, srt; bulk export\",\"readEditAllowBulkExport\":\"read, edit, allow, bulk export\",\"authenticatorApp\":\"Authenticator App\",\"authenticatorAppSms\":\"Authenticator App, SMS (US/Canada only)\",\"minimumUserLicense\":\"Minimum {userCount}-user license required\",\"playbackSpeeds\":\"0.5x, 0.75x, 1x, 1.25x, 1.5x, 1.75x, 2x, 3x, skip silence\",\"unlimitedShared\":\"Unlimited (shared)\",\"users\":\"{count, plural, one {# user} other {# users}}\",\"none\":\"None\"}},\"studentTeacherDiscount\":\"Student \u0026 Teacher Discount\",\"invalidStudentEmail\":\"To get the educational discount, please change to your school email address in your Otter account settings and try again.\",\"asteriskExplanation\":\"Shared pool across all transcription types\",\"indiaDiscountDisclaimer\":\"*Offer valid only with an India-issued credit card.\"},\"settings:developer\":{\"title\":\"Developer\",\"description\":\"Manage your API keys to keep your account secure and protected.\",\"apiKeySectionTitle\":\"API Keys\",\"apiKeySectionDescription\":\"Securely upload recordings, access transcripts, and integrate Otter into your tools and workflows. \u003capi-docs-link\u003eSee API docs\u003c/api-docs-link\u003e\",\"apiDocsUrl\":\"https://help.otter.ai/hc/en-us/articles/36130822688279\",\"createKeyButton\":\"Create key\",\"apiKeyLimitReached\":\"API key limit reached\",\"deleteButton\":\"Delete\",\"apiKeys\":{\"apiKeyName\":\"Key\",\"created\":\"Created\",\"lastUsed\":\"Last used\"},\"deleteModal\":{\"title\":\"Delete API Key\",\"confirmDeleteButton\":\"Delete Key\",\"cancelButton\":\"Not now\",\"deleteWarningMessage\":\"This action is permanent. Any apps or integrations using this key will immediately lose access to your workspace.\"},\"generateModal\":{\"title\":\"API Key Created\",\"description\":\"Use this API key to connect Otter with your tools and workflows. It's visible only once to protect your workspace.\",\"generating\":\"Generating...\",\"copyButton\":\"Copy\",\"apiKeyCopied\":\"API key copied\",\"warningTitle\":\"API key not copied\",\"warningMessage\":\"This key won't be shown again. If you haven't saved it, we recommend copying it now.\",\"copyAndCloseButton\":\"Copy \u0026 close\",\"closeAnywayButton\":\"Close anyway\"}},\"settings:new-apps-page\":{\"title\":\"My New Apps Page\",\"description\":\"Manage your apps\",\"myIntegrations\":\"My Integrations\",\"discover\":\"Discover\",\"descriptionTitle\":\"Description\",\"settings\":\"Settings\",\"learnMore\":\"Learn more\",\"buttons\":{\"tryForFree\":\"Try for free\",\"connect\":\"Connect\",\"connectForAll\":\"Connect for all\",\"disconnect\":\"Disconnect\",\"upgrade\":\"Upgrade\",\"contactSales\":\"Contact Sales\",\"requestAccess\":\"Request access\",\"askAdmin\":\"Ask admin\",\"on\":\"On\",\"off\":\"Off\",\"viewMore\":\"View more\",\"add\":\"Add\",\"confirm\":\"Confirm\",\"maybeLater\":\"Maybe later\",\"cancel\":\"Cancel\",\"yesRemove\":\"Yes, remove\",\"reactivate\":\"Reactivate\",\"done\":\"Done\"},\"crmPaywall\":{\"dialogTitle\":\"CRM connection limit reached\",\"freeAdminMessage\":\"\u003cbold\u003eCRM connection limit reached.\u003c/bold\u003e Get more with Pro plan or try for free.\",\"proAdminMessage\":\"\u003cbold\u003eCRM connection limit reached.\u003c/bold\u003e Get more with Business plan.\",\"teamAdminMessage\":\"\u003cbold\u003eCRM connection limit reached.\u003c/bold\u003e Get unlimited with Enterprise plan.\",\"memberMessage\":\"\u003cbold\u003eCRM connection limit reached.\u003c/bold\u003e Request your admin to upgrade so you can sync.\",\"adminConnectionsLeft\":\"\u003cbold\u003eYou have {remaining} CRM connection{remaining, plural, one {} other {s}} left.\u003c/bold\u003e Get unlimited with Enterprise plan.\"},\"connectedAppInfo\":{\"connectMeetings\":\"Connect meetings\",\"configurationError\":\"Configuration error\"},\"info\":{\"disconnectSuccess\":\"Successfully disconnected {accountName} account\",\"disconnectError\":\"There was a problem disconnecting the {accountName} account. Please try again.\",\"missingCode\":\"Oops, the {appName} authorization code is missing.\",\"connectSuccess\":\"Successfully connected {appName} account\",\"connectFailed\":\"There was a problem connecting to the {appName}. Please try again.\",\"alreadyAssociatedWithAnotherOtterAccount\":\"Your {appName} account is associated with another Otter account. Disconnect it first and try again.\",\"unsupportedSource\":\"Oops, the app “{source}” is not supported by Otter.\",\"oauthCallback\":{\"redirecting\":\"Redirecting to your Otter…\",\"pleaseWait\":\"Please wait a moment while we complete the connection...\",\"ifNotRedirected\":\"If you weren't redirected, \u003clink\u003eclick here.\u003c/link\u003e\",\"return\":\"Return\",\"missingOAuthCode\":\"Missing OAuth code\",\"unknownSource\":\"Unknown OAuth source\",\"connectFailedRetry\":\"Failed to connect {appName}. Please try again.\",\"adminConsentSuccess\":\"Admin consent granted. \u003cbr\u003e\u003c/br\u003eReturn to \u003cotterLink\u003eOtter\u003c/otterLink\u003e and connect your Microsoft account.\",\"adminConsentFailureTitle\":\"We couldn't grant admin consent.\",\"adminConsentFailureHelp\":\"Please try again, or see \u003chelpLink\u003eGrant Microsoft Entra Admin Consent for Otter\u003c/helpLink\u003e for help.\"}},\"disconnectModal\":{\"titleWithEmail\":\"Remove access to {appName} for {email}?\",\"titleWithoutEmail\":\"Remove access to {appName}?\"},\"tags\":{\"new\":\"New\",\"enterprise\":\"Enterprise\",\"pro\":\"Pro\"},\"appDescription\":\"Connect your Otter.ai account with your {app_name} account.\",\"defaultShortIntro\":\"Automatically sync transcripts and meeting notes between Otter and {app_name}.\",\"defaultLongIntro\":\"Connecting to Otter lets you automatically sync transcripts, summaries, insights, and action items with {app_name}. After each meeting ends, relevant data is shared with {app_name} based on your workspace settings.\",\"exportSettings\":{\"saveMeetingNotesTitle\":\"Save meeting notes to {appName}\",\"modifyExportSettingsTitle\":\"Modify export settings\",\"folderDescription\":\"After transcription is complete, export to the \\\"{destinationName}\\\" folder in {appName}\",\"selectFileFormat\":\"Select file format for export\",\"selectItems\":\"Select items to export\",\"filterMeetings\":\"Filter meetings for export\",\"selectPlaceholder\":\"Select\",\"siteUrlLabel\":\"SharePoint site URL\",\"siteUrlPlaceholder\":\"https://yourcompany.sharepoint.com/sites/Otter\",\"siteUrlTooltip\":\"Open the SharePoint site where you want Otter to save meeting files, then copy the URL from your browser’s address bar.\",\"siteUrlHelpAria\":\"How to find your SharePoint site URL\",\"save\":\"Save\",\"savingSuccess\":\"Export settings successfully saved.\",\"savingError\":\"There was a problem saving the export settings. Please try again.\"},\"apps\":{\"zoom_phone\":{\"description\":\"Get automated summaries and transcripts for all future Zoom Phone call recordings.\"},\"outreach\":{\"description\":\"Get automated summaries and transcripts for all future Outreach call recordings.\"},\"google_drive\":{\"title\":\"Google Drive\",\"intro\":\"Connect Google Drive to export meeting notes or import files into AI Chat.\",\"description\":\"\u003cp\u003eConnecting Google Drive to Otter lets you search your Drive files and create new Google Docs directly from AI Chat. This helps you find answers where they are and turn them into documentation without switching tools.\u003c/p\u003e\",\"descriptionExportAddon\":\"\u003cp\u003ePlus, export your meeting notes directly to Google Drive after your meeting ends for easy access.\u003c/p\u003e\"},\"microsoft_onedrive\":{\"title\":\"Microsoft OneDrive\",\"intro\":\"Export your meeting notes to Microsoft OneDrive.\",\"description\":\"\u003cp\u003eAfter a meeting, create a new file with your notes in Microsoft OneDrive.\u003c/p\u003e\"},\"sharepoint\":{\"title\":\"Microsoft SharePoint\",\"intro\":\"Export your workspace’s meetings to Microsoft SharePoint\",\"description\":\"\u003cp\u003eAfter each meeting, create a corresponding file in Microsoft SharePoint.\u003c/p\u003e\"},\"notion\":{\"title\":\"Notion\",\"intro\":\"Use AI Chat to find answers in your Notion workspace and create documentation.\",\"description\":\"\u003cp\u003eConnecting Notion to Otter lets you search your Notion workspace and create documentation directly from AI Chat. This helps you turn answers into shared knowledge without switching tools.\u003c/p\u003e\"},\"jira\":{\"title\":\"Jira\",\"intro\":\"Use AI Chat to create or summarize Jira work items or Confluence pages.\",\"description\":\"\u003cp\u003eConnecting Jira to Otter lets you create and update Jira work items or Confluence pages directly from AI Chat. This helps you move from conversation to execution without switching tools.\u003c/p\u003e\"},\"greenhouse\":{\"title\":\"Greenhouse\",\"intro\":\"Use AI Chat to search Greenhouse and update scorecards.\",\"description\":\"\u003cp\u003eConnecting Greenhouse to Otter lets you search Greenhouse and update scorecards directly from AI Chat. This helps you move from interview to candidate management without switching tools.\u003c/p\u003e\"},\"gmail\":{\"title\":\"Gmail\",\"intro\":\"Add your Gmail as a source for AI Chat to search and draft emails.\",\"description\":\"\u003cp\u003eConnecting Gmail to Otter lets you combine meeting data with your inbox and draft emails directly from AI Chat. This helps you turn conversations into informed follow-ups without switching tools.\u003c/p\u003e\u003cp\u003eOtter only fetches emails when you ask. No full mailbox indexing.\u003c/p\u003e\"},\"slack\":{\"title\":\"Slack\",\"intro\":\"Automatically share meeting summaries and live notes directly into Slack.\",\"description\":\"\u003cp\u003eAutomatically share live meeting notes and summaries directly to Slack so everyone on your team stays in the loop.\u003c/p\u003e\",\"recurringMeetingUpdates\":{\"title\":\"Recurring meeting updates\",\"description\":\"Connect your recurring meetings to Slack channels to automatically share live Otter notes and post-meeting summaries.\",\"descriptionWithCount\":\"You have {count} {count, plural, one {meeting} other {meetings}} scheduled to post to Slack:\",\"recurringMeetingUpdatesStepTitle\":\"Post automatic meeting notes to Slack\",\"recurringMeetingUpdatesStepDescription\":\"Send live Otter notes and follow-up summaries to your Slack channels automatically.\",\"change\":\"Change\",\"configure\":\"Configure\"},\"calendarConnection\":{\"calendarConnectionStepTitle\":\"Connect your calendar\",\"calendarConnectionStepDescription\":\"Otter syncs your calendar to capture and share meeting notes in Slack.\",\"googleCalendar\":\"Google Calendar\",\"microsoftCalendar\":\"Microsoft Outlook Calendar\",\"connectButton\":\"Connect\",\"connectingButton\":\"Connecting…\"},\"mcpReconnect\":{\"bannerMessage\":\"Reconnect Slack to search your workspace in AI Chat.\",\"title\":\"Reconnect your Slack account\",\"description\":\"Your Slack connection needs to be renewed to search Slack messages and channels in AI Chat.\",\"reconnectButton\":\"Reconnect\"}},\"salesforce\":{\"title\":\"Salesforce\",\"intro\":\"Enrich Salesforce with your meeting notes automatically.\",\"description\":\"\u003cp\u003eAutomatically enrich Salesforce Opportunities, Contacts, and Leads with your meeting notes to streamline follow-ups, keep your CRM current, and help every deal stay on track.\u003c/p\u003e\",\"descriptionWithAIChat\":\"\u003cp\u003eAutomatically enrich Salesforce Opportunities, Contacts, and Leads with your meeting notes to streamline follow-ups, keep your CRM current, and help every deal stay on track.\u003c/p\u003e\u003cp\u003ePlus, Otter's AI Chat can search Salesforce so you can get instant answers, helping you uncover deeper insights and make more informed decisions.\u003c/p\u003e\",\"learnMoreUrl\":\"https://help.otter.ai/hc/en-us/articles/15671309340183-Otter-ai-Salesforce-Integration-Guide\",\"workspaceConnection\":{\"title\":\"Workspace Connection\",\"description\":\"Authenticate Salesforce for all users in your Otter workspace.\"},\"crmSettings\":{\"templatesWithInsightsTitle\":\"Templates with Insights\",\"mapFieldsSalesforceTitle\":\"Salesforce Opportunity field mapping\",\"mapFieldsSalesforceDescription\":\"Customize field mappings to sync insights to specific Salesforce Opportunity fields\",\"mapFieldsHubspotTitle\":\"HubSpot Deal property mapping\",\"mapFieldsHubspotDescription\":\"Customize field mappings to sync insights to specific HubSpot Deal properties\",\"fieldColumn\":\"{crmName} field\",\"helpCenterUrl\":\"https://help.otter.ai/hc/en-us/articles/29730579913751-CRM-Integration-Sync-Insights-to-Custom-Fields\",\"editTemplate\":\"Edit template\",\"insightColumn\":\"Insight\",\"writeBehaviorColumn\":\"Write behavior\",\"enableColumn\":\"Enable\",\"chooseField\":\"Choose a field\",\"clearField\":\"Clear field\",\"writeIfEmpty\":\"Write if empty\",\"overwrite\":\"Overwrite\",\"append\":\"Append\",\"writeBehavior\":\"Write behavior\",\"aiDefinition\":\"AI definition\",\"noAutofillConfigs\":\"No autofill configurations available\",\"requireTeamConnectionTitle\":\"Requires Salesforce Team connection\",\"requireTeamConnectionDescription\":\"Auto-sync key insights to the right Salesforce fields\",\"requireTeamConnectionInstruction\":\"To enable this feature, click Connect for all\"},\"settings\":{\"mapFields\":\"Map fields\",\"salesforceTaskCreation\":\"Salesforce Task creation\",\"salesforceTaskCreationDescription\":\"Create a Task for calendar guests matching Salesforce contacts\",\"changeExportSettings\":\"Change export settings\",\"exportsToSalesforce\":\"Exports to Salesforce\",\"exportsToSalesforceDescription\":\"Push insights after the meeting ends\",\"aiChatWithSalesforce\":\"Otter AI Chat with Salesforce\",\"aiChatWithSalesforceDescription\":\"Get quick answers based on your Salesforce data\",\"automatic\":\"Automatic\",\"manual\":\"Manual\"}},\"hubspot\":{\"title\":\"HubSpot\",\"intro\":\"Sync meeting notes to HubSpot to improve follow-ups and pipeline visibility.\",\"description\":\"\u003cp\u003eAutomatically bring your call insights into the right HubSpot records, saving time on manual data entry and giving your team better visibility across the pipeline.\u003c/p\u003e\",\"learnMoreUrl\":\"https://help.otter.ai/hc/en-us/articles/19439009788951\",\"workspaceConnection\":{\"title\":\"Workspace Connection\",\"description\":\"Authenticate HubSpot for all users in your Otter workspace.\"},\"crmSettings\":{\"requireTeamConnectionTitle\":\"Requires HubSpot Team connection\"},\"settings\":{\"mapFields\":\"Map fields\",\"exportsToHubspot\":\"Exports to HubSpot\",\"exportsToHubspotDescription\":\"Push insights after the meeting ends\",\"hubspotMeetingCreation\":\"HubSpot Meeting creation\",\"hubspotMeetingCreationDescription\":\"Create a Meeting for calendar guests matching HubSpot contacts\",\"allWorkspaceUsers\":\"All workspace users\",\"onlyMe\":\"Only me\",\"automatic\":\"Automatic\",\"manual\":\"Manual\"}},\"google\":{\"title\":\"Google Calendar\",\"intro\":\"Sync Google Calendar for Otter to find and capture your meetings.\",\"description\":\"\u003cp\u003eConnecting Google Calendar and Contacts to Otter lets Otter automatically detect and join your Google Meet calls, identify attendees, and match notes to the correct events.\u003c/p\u003e\u003cp\u003eIt also streamlines sharing by sending transcripts and summaries to the people already on your invite list.\u003c/p\u003e\",\"addAnotherAccountTitle\":\"Add another account\",\"addAnotherAccount\":\"You can connect multiple Google Calendar accounts to Otter.ai.\"},\"microsoft\":{\"title\":\"Microsoft Outlook Calendar\",\"intro\":\"Connect Microsoft Outlook Calendar so Otter can join and record your meetings.\",\"description\":\"\u003cp\u003eConnecting your Microsoft Outlook Calendar can allow Otter to automatically detect your meetings, join them, identify attendees, match notes to the right events, and replay video.\u003c/p\u003e\",\"addAnotherAccountTitle\":\"Add another account\",\"addAnotherAccount\":\"You can connect multiple Microsoft Outlook calendars to Otter.ai.\",\"enterpriseFeatures\":{\"title\":\"Enterprise workspace features\",\"videoReplay\":\"Video replay\",\"videoReplayDescription\":\"Enterprise workspaces can replay meeting video in Otter.\"}},\"dropbox\":{\"title\":\"Dropbox\",\"intro\":\"Automatically transcribe Dropbox audio and video and save back to Dropbox.\",\"description\":\"\u003cp\u003eConnecting Dropbox to Otter lets you automatically import audio and video files for transcription and AI-generated notes. Once processed, Otter can save your transcripts and notes back to your Dropbox so everything stays in one place.\u003c/p\u003e\u003cp\u003eAudio \u0026 video files in your Dropbox \\\"Apps/Otter\\\" folder will be automatically transcribed to \\\"My Conversations\\\" in Otter.\u003c/p\u003e\",\"businessSubscriptionExpired\":\"Oops, Dropbox is not available because your Business subscription has expired. Please contact your admin to reactivate your Business subscription.\",\"missingCode\":\"Oops, the Dropbox authorization code is missing. Please try again.\",\"saveTranscriptsToDropbox\":{\"title\":\"Save transcripts to Dropbox\",\"description\":\"After transcription is complete, it is auto-pushed into your Dropbox \\\"Apps/Otter\\\" folder.\",\"save\":\"Save\",\"selectPlaceholder\":\"Select\",\"text\":\".txt\",\"docx\":\".docx\",\"pdf\":\".pdf\",\"srt\":\".srt\",\"showSpeakerNames\":\"Show speaker names\",\"showTimestamps\":\"Show timestamps\",\"showHighlights\":\"Show highlights\",\"showImages\":\"Show images\",\"showParagraphsOfSameSpeaker\":\"Combine paragraphs of the same speaker\",\"removeOtterBranding\":\"Remove Otter branding\",\"addLineBreaksAutomatically\":\"Add line breaks automatically\",\"savingError\":\"There was a problem saving the export settings. Please try again.\",\"savingSuccess\":\"Export settings successfully saved.\",\"autoExportEnabled\":\"Auto export enabled\",\"autoExportDisabled\":\"Auto export disabled\",\"modifyExportSettings\":\"Change export settings\",\"selectFileFormat\":\"Select file format for export\"}},\"workato\":{\"iframeTitle\":\"Workato Authentication\"},\"zapier\":{\"title\":\"Zapier\",\"intro\":\"Easily link Otter with other tools in your workflow to automate imports and exports.\",\"description\":\"\u003cp\u003eIntegrating Zapier with Otter allows you to build Zaps that import audio into Otter or export transcripts, summaries, and action items to your other tools automatically.\u003c/p\u003e\",\"connectUrl\":\"https://zapier.com/apps/otterai/integrations\",\"importNote\":\"Importing audio files will consume your monthly minute limits.\",\"setup\":{\"title\":\"Zapier Setup\",\"configureOnZapier\":\"Configure on Zapier\"},\"apiKey\":{\"title\":\"API Key\",\"description\":\"Add your Otter API key on Zapier to get started.\"}},\"zoom\":{\"title\":\"Zoom\",\"intro\":\"Automatically capture and summarize your Zoom meetings with live transcripts and notes.\",\"description\":\"\u003cp\u003eConnecting Zoom to Otter lets your Notetaker automatically capture, transcribe, and summarize your meetings.\u003c/p\u003e\",\"moreZoomOptions\":{\"title\":\"More Zoom options\",\"notetakerNote\":\"Your Notetaker can still join meetings on your calendar to summarize.\",\"liveNotes\":{\"title\":\"Otter Live Notes\",\"description\":\"Set up bot-free, real-time transcripts during Zoom meetings you host.\"},\"cloudSync\":{\"title\":\"Cloud Sync Recordings\",\"description\":\"Get transcripts and summaries from your Zoom cloud recordings post-meeting automatically.\"},\"savingError\":\"There was a problem saving the Zoom settings. Please try again.\",\"settingsDisabled\":\"Zoom options disabled\"},\"manageMeetings\":{\"title\":\"Manage Zoom meetings and webinar\",\"description\":\"Configure transcription settings for your Zoom meetings and schedule live-transcribed webinars.\"},\"miniOnboarding\":{\"title\":{\"cloudSync\":\"Next step configure Zoom to enable sync cloud recordings\",\"liveNotes\":\"Your Zoom account has been connected!\"},\"subtitle\":{\"liveNotes\":\"If you'd like to use the Otter Live Notes integration, here are the next steps:\"},\"errors\":{\"cloudSyncNotEnabled\":\"Zoomʼs Cloud Sync is not enabled for your Zoom account.\",\"configurationCheckFailed\":\"Failed to check configuration. Please try again.\",\"configurationIssue\":\"Configuration issues: {issues}\",\"unableToFindZoomConnection\":\"We were unable to find your Zoom connection.\"},\"steps\":{\"step1\":{\"label\":\"1. Follow easy step by step guide\",\"button\":\"Configuration Guide\"},\"step2\":{\"labelCloudSync\":\"2. Create a 10 second Zoom recording to test sync cloud recordings\",\"labelLiveNotes\":\"2. Test Configuration\",\"buttonCloudSync\":\"Create Zoom Recording\",\"buttonLiveNotes\":\"Test configuration\"},\"skipButton\":\"Skip\"},\"helpUrls\":{\"cloudSync\":\"https://otter.ai/blog/zoom-sync\",\"liveNotes\":\"https://help.otter.ai/hc/en-us/articles/7795227077399\"}},\"warningError\":{\"setupTitle\":\"To complete setup follow configuration guide and test configuration\",\"reconnectTitle\":\"Reconnect your Zoom account\",\"tokenInvalidError\":\"Your Zoom token is invalid. Please reconnect your account.\",\"reconnectRequiredError\":\"Your Zoom account needs to be reconnected. Please reconnect your account.\",\"configurationIssueBanner\":\"Your Zoom configuration has an issue. Open Zoom settings to review and complete setup.\",\"configurationIssueError\":\"Encountered configuration issue. Please review our \u003ctroubleshootLink\u003etroubleshooting guide\u003c/troubleshootLink\u003e and update your Zoom settings at \u003czoomLink\u003ezoom.us\u003c/zoomLink\u003e\",\"openButton\":\"Open\",\"reconnectButton\":\"Reconnect\",\"reconnectError\":\"There was a problem reconnecting your Zoom account. Please try again.\",\"troubleshootUrl\":\"https://otter.ai/blog/troubleshoot-zoom-sync-problem\",\"zoomUrl\":\"https://zoom.us\",\"configurationGuideButton\":\"1. Configuration guide\",\"testConfigurationButton\":\"2. Test configuration\",\"testCreateRecordingButton\":\"2. Test - Create Zoom recording\",\"zoomSetupUrl\":\"https://otter.ai/blog/zoom#SETUP\",\"zoomSyncUrl\":\"https://otter.ai/blog/zoom-sync\",\"zoomMeetingUrl\":\"https://zoom.us/meeting\"}}}},\"settings:team\":{\"autoJoin\":{\"title\":\"Auto-join setting for workspace members\",\"tooltip\":\"Automatically send AI {virtualAssistant} to join calendar meetings on Zoom, Microsoft Teams, and Google Meet.\",\"membersCanSetTo\":\"Members can set their auto-join to:\",\"default\":\"(default)\",\"settingStatus\":\"Your auto-join setting is {status} so your workspace members {explanation}\",\"locked\":\"locked\",\"notLocked\":\"not locked\",\"lockedExplanation\":\"cannot change their own default auto-join setting. Members can still configure auto-join for individual meetings.\",\"unlockedExplanation\":\"can change their own default auto-join setting. Members can also configure auto-join for individual meetings.\",\"editButton\":\"Edit\",\"options\":{\"all\":\"Meetings with a video conference link\",\"organizedByMe\":\"Meetings where the member is the host\",\"external\":\"External meetings: includes guests without an {domain} email\",\"internal\":\"Internal meetings: all guests have an {domain} email\",\"userSelected\":\"Meetings the member manually selects\"},\"modal\":{\"title\":\"Auto-joining setting for workspace members\",\"cancel\":\"Cancel\",\"confirm\":\"Confirm\",\"lockSetting\":\"Lock this setting\",\"lockDescription\":\"Members cannot change their own auto-join setting\",\"noChanges\":\"No changes to auto-join settings.\",\"successUpdate\":\"Updated default auto-join setting for all workspace members.\",\"errorUpdate\":\"Failed to update autojoin settings.\"}},\"autoShare\":{\"title\":\"Auto-sharing options for workspace members\",\"tooltip\":\"When recording a calendar event, automatically share notes with your selected audience.\",\"membersCanShare\":\"Members can auto-share notes with:\",\"default\":\"(default)\",\"editButton\":\"Edit\",\"modal\":{\"title\":\"Auto-sharing options for workspace members\",\"cancel\":\"Cancel\",\"next\":\"Next\",\"back\":\"Back\",\"apply\":\"Apply changes\",\"successUpdate\":\"Auto-sharing settings have been updated successfully\",\"errorUpdate\":\"Failed to update auto-sharing settings. Please try again.\"}},\"customizeOAName\":{\"title\":\"Rename your Otter Notetaker\",\"description\":\"This is the name your meeting attendees will see.\",\"memberName\":\"Member's name\",\"editDisplayName\":\"Edit display name\",\"preview\":\"Preview of what your Otter Notetaker will be named: \\\"{firstName}'s {name}\\\"\",\"successUpdate\":\"Notetaker name updated successfully\",\"altTextUpdate\":\"Notetaker name updated\",\"errorUpdate\":\"Failed to update Notetaker name. Please try again.\"},\"displayTimecodes\":{\"title\":\"Display Timecodes\",\"description\":{\"para1\":\"Show a time code (HH:MM:SS) instead of a relative timestamp (e.g. 0:00, 1:29:59) at the beginning of each paragraph of a conversation.\",\"para2\":\"By default, time codes are based on the absolute time when recording took place.\",\"para3\":\"Time codes can also be manually edited, or derived from of a starting time code in an ID3 tag of an imported MP3 file.\"},\"tooltip\":{\"enable\":\"Enable time codes\",\"disable\":\"Disable time codes\"},\"successUpdate\":\"Display timecodes setting updated successfully\",\"altTextUpdate\":\"Timecode settings updated\",\"errorUpdate\":\"Failed to update timecode settings. Please try again.\"},\"transcriptCopy\":{\"title\":\"Prevent Guest \u0026 Viewers from selecting and copying text\",\"description\":\"If toggled on, only users with Collaborator permissions can copy the text from shared conversations.\",\"tooltip\":{\"enable\":\"Enable the transcript copy\",\"disable\":\"Disable the transcript copy\"},\"successUpdate\":\"Transcript copy permission updated successfully\",\"altTextUpdate\":\"Permission updated\",\"errorUpdate\":\"Failed to update transcript copy permission. Please try again.\"},\"socialSharing\":{\"title\":\"Disable social sharing features\",\"description\":\"Remove the menu options that let workspace members post text snippets on Facebook, LinkedIn, and Twitter.\",\"tooltip\":{\"enable\":\"Enable social sharing features\",\"disable\":\"Disable social sharing features\"},\"successUpdate\":\"Social sharing setting updated successfully\",\"altTextUpdate\":\"Social sharing updated\",\"errorUpdate\":\"Failed to update social sharing setting. Please try again.\"},\"twoFactorAuth\":{\"title\":\"Two-factor authentication\",\"description\":\"Require two-factor authentication for the team to set up and use two-factor authentication (2FA) for signing in using Google Authenticator\",\"descriptionWithSms\":\" or SMS\",\"tooltip\":{\"enable\":\"Enable two-factor authentication\",\"disable\":\"Disable two-factor authentication\"},\"successUpdate\":\"Two-factor authentication {status} successfully\",\"enabled\":\"enabled\",\"disabled\":\"disabled\",\"altTextUpdate\":\"2FA updated\",\"errorUpdate\":\"Failed to update two-factor authentication. Please try again.\",\"limitedPlanMessage\":\"This feature requires a paid Business subscription. Please upgrade your plan to enable two-factor authentication.\",\"confirmDialog\":{\"notSetupTitle\":\"Your 2FA is not setup\",\"notSetupMessage\":\"Please set up two-factor authentication (2FA) for your own account first before turning on Require two-factor authentication for the team\",\"notSetupConfirm\":\"Set up\",\"enableTitle\":\"Team-wide two-factor authentication\",\"enableMessage\":\"Would you like to enable two-factor authentication for your Team?\",\"enableWarning\":\"Warning:\",\"enableWarningText\":\"Members who have not set up 2FA before will be immediately signed out of Otter and prompted to set up 2FA before signing in again. New members will also be required to set up 2FA before signing in to Otter.\",\"enableConfirm\":\"Enable\",\"disableTitle\":\"Team-wide two-factor authentication\",\"disableMessage\":\"Would you like to disable two-factor authentication for your Team?\",\"disableConfirm\":\"Disable\",\"cancel\":\"Cancel\"}},\"samlAuth\":{\"title\":\"SAML Authentication\",\"description\":\"To set up SAML 2.0 Single Sign-On, please follow the instructions in this\",\"setupGuide\":\"setup guide\",\"configureButton\":\"Configure\",\"enableSaml\":\"Enable SAML\",\"allowOtherLogins\":\"Allow other login options\",\"recommendedTesting\":\"(recommended during testing period)\",\"requireSso\":\"Require SSO for all Team members\",\"enabled\":\"enabled\",\"disabled\":\"disabled\",\"successUpdate\":\"SAML {status} successfully\",\"successRequirementUpdate\":\"SSO requirement updated successfully\",\"altTextUpdate\":\"SAML updated\",\"altTextSsoUpdate\":\"SSO updated\",\"errorUpdate\":\"Failed to update SAML settings. Please try again.\",\"errorRequirementUpdate\":\"Failed to update SSO requirement. Please try again.\",\"modal\":{\"title\":\"Configure SAML Authentication (SSO)\",\"description\":\"Fill out the fields below to set up Teams with your custom SSO solution. For detailed walkthrough review the\",\"setupGuide\":\"setup guide\",\"saveAndTest\":\"Save and Test\",\"teamHandle\":\"Your Otter team handle\",\"teamHandleTooltip\":\"You need 'team handle' to configure your identity provider. See Setup Guide for further information.\",\"copy\":\"Copy\",\"samlEndpoint\":{\"label\":\"SAML Endpoint\",\"description\":\"Enter your SAML Endpoint. This is where you go when you try to login.\",\"placeholder\":\"Paste SAML Endpoint here\",\"required\":\"SAML Endpoint is required\",\"pattern\":\"SAML Endpoint format is invalid\",\"default\":\"Valid SAML Endpoint is required\"},\"identityProvider\":{\"label\":\"Identity Provider Issuer\",\"description\":\"The IdP Entity ID for the service you use.\",\"placeholder\":\"Paste Identity Provider Issuer here\",\"required\":\"Identity Issuer Provider is required\",\"default\":\"Valid Identity Issuer Provider is required\"},\"publicCertificate\":{\"label\":\"Public Certificate\",\"description\":\"Copy and paste your entire x.509 Certificate here.\",\"placeholder\":\"Paste Public Certificate here\",\"required\":\"Public Certificate is required\",\"default\":\"Valid Public Certificate is required\"},\"advancedSettings\":\"Advanced Settings\",\"optional\":\"(optional)\",\"downloadCertificate\":\"Download Certificate\",\"signAuthNRequest\":\"Sign AuthNRequest\",\"requireAssertionEncryption\":\"Require Assertion Encryption\",\"requireNameIdEncryption\":\"Require NameID Encryption\",\"successUpdate\":\"SSO settings updated successfully\",\"altTextUpdate\":\"SSO settings updated\",\"errorUpdate\":\"Failed to update SSO settings. Please try again.\",\"copiedToClipboard\":\"Copied to clipboard\",\"copiedAltText\":\"Copied\",\"errorDownloadCertificate\":\"Failed to download certificate. Please try again.\"}},\"directorySync\":{\"title\":\"Directory Sync (via SCIM)\",\"description\":\"Automatically provision and manage your Otter workspace users from your directory.\",\"configureButton\":\"Configure\",\"configuring\":\"Setting up...\",\"enableDirectorySync\":\"Enable Directory Sync\",\"switchDisabledTooltip\":\"Directory Sync is pending configuration. Click Configure to finish the setup.\",\"enabled\":\"enabled\",\"disabled\":\"disabled\",\"successUpdate\":\"Directory Sync {status} successfully\",\"errorUpdate\":\"Failed to update Directory Sync settings. Please try again.\"},\"removeAudio\":{\"title\":\"Remove Audio Recordings\",\"description\":\"This will permanently remove access to all existing and future audio recordings, including playback and export.\",\"successUpdate\":\"Audio {status} successfully\",\"enabled\":\"enabled\",\"disabled\":\"disabled\",\"altTextUpdate\":\"Audio setting updated\",\"errorUpdate\":\"Failed to update audio setting. Please try again.\",\"tooltip\":{\"enable\":\"Enable audio recordings\",\"disable\":\"Remove audio recordings\"},\"confirmDialog\":{\"title\":\"Remove audio recordings\",\"message\":\"This will permanently remove access to all existing and future audio recordings, including playback and export.\",\"confirm\":\"Remove Audio\",\"cancel\":\"Cancel\"}},\"preMeetingDisclaimer\":{\"title\":\"Pre-recording emails setting for workspace members\",\"description\":\"For all meetings Notetaker is scheduled to join, choose whether to notify all calendar event guests in advance about Notetaker recording the meeting.\",\"successUpdate\":\"Pre-recording email {status} successfully\",\"enabled\":\"enabled\",\"disabled\":\"disabled\",\"locked\":\"locked\",\"notLocked\":\"unLocked\",\"altTextUpdate\":\"Pre-meeting disclaimer updated\",\"errorUpdate\":\"Failed to update pre-recording email setting. Please try again.\",\"tooltip\":{\"enable\":\"Enable notification\",\"disable\":\"Disable notification\",\"lock\":\"Lock setting\",\"unlock\":\"Unlock setting\"},\"editButton\":\"Edit\",\"defaultSettingTitle\":\"Default pre-recording email setting\",\"lockSettingTitle\":\"Lock default pre-recording email setting\",\"lockSettingDescription\":\"Locking the default pre-recording email setting will prevent your workspace members from being able to change the option you selected.\"},\"externalSharing\":{\"title\":\"Disable external sharing\",\"description\":\"Restrict conversation sharing to {domains} email addresses only.\",\"successUpdate\":\"External sharing setting updated successfully\",\"altTextUpdate\":\"External sharing updated\",\"errorUpdate\":\"Failed to update external sharing setting. Please try again.\",\"tooltip\":{\"enable\":\"Enable external sharing\",\"disable\":\"Disable external sharing\"}},\"voiceChat\":{\"title\":\"Meeting Agent with voice\",\"description\":\"Allow users to use voice to ask questions and issues commands during live recordings.\",\"background\":{\"title\":\"Show virtual background with Meeting Agent\",\"description\":\"Display a virtual background during meetings to highlight voice capabilities.\"}},\"teamExpansion\":{\"title\":\"Control how teammates enter your Workspace\",\"subtitle\":\"Manage how teammates join your Workspace to protect your organization's data and provide peace of mind.\",\"workspaceDomain\":\"Workspace domain\",\"domainDescription\":\"This is set by your account email. Your Workspace will be discoverable by members within the same email domain.\",\"learnMore\":\"Learn more\",\"discoverability\":{\"titleBasic\":\"Allow teammates to join instantly as members\",\"title\":\"Allow teammates to join instantly as free trial members\",\"description\":\"When this is On, teammates with {domains} email do not require Admin approval.\",\"tooltip\":{\"enable\":\"Enable Admin approval\",\"disable\":\"Disable Admin approval\"}},\"shareInvite\":{\"titleBasic\":\"Automatically invite conversation recipients as members\",\"title\":\"Automatically invite conversation recipients as free trial members\",\"description\":\"When this is On, sharing a conversation with teammates with {domains} email also invites them to join the Workspace.\",\"paidLicenseNotice\":\"Accepted invites sent by admins using the \u003cinviteButton\u003e\u003c/inviteButton\u003e button result in a paid member license charge.\",\"tooltip\":{\"enable\":\"Disable invite when sharing\",\"disable\":\"Enable invite when sharing\"}},\"inviteLink\":{\"title\":\"Allow teammates to join via invite link\",\"description\":\"Turning off disables existing invite links and hides the invite link option.\",\"successUpdateAndCopied\":\"Invite link setting updated successfully. Invite link copied.\",\"tooltip\":{\"enable\":\"Enable invite link\",\"disable\":\"Disable invite link\"},\"requireApproval\":{\"title\":\"Require admin approval for users joining via invite link\",\"description\":\"When this is On, users who join via an invite link must be approved by an Admin before accessing the Workspace.\",\"tooltip\":{\"enable\":\"Enable admin approval\",\"disable\":\"Disable admin approval\"}}},\"noDomain\":{\"title\":\"Workspace features\",\"descriptionUnverifiedOwner\":\"Verify your Otter account email to activate all of the Workspace features.\",\"descriptionUnverifiedAdmin\":\"Request that account owner verify their Otter account email to see all of the Workspace features.\",\"descriptionPublicOwner\":\"Update your account email to one associated with your organization to activate all of the Workspace features.\",\"descriptionPublicAdmin\":\"Request that Workspace owner update the account email to one associated with your organization to activate all of the Workspace features.\",\"features\":{\"0\":\"Control how new members enter your Workspace\",\"1\":\"Surface your Workspace to new and existing Otter members within your email domain\",\"2\":\"Allow your Workspace members to add new teammates for a free trial period\"},\"actionUnverifiedOwner\":\"Resend email\",\"actionPublicOwner\":\"Update email\",\"actionAdmin\":\"Contact owner\"},\"successUpdate\":\"Team expansion setting updated successfully\",\"altTextUpdate\":