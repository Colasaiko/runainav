eateWebhook\":\"Create webhook\"}}},\"errors\":{\"somethingWentWrong\":\"Whoops, something went wrong…\",\"details\":\"Details\",\"reloadSection\":\"Reload section\"},\"global-overlays\":{\"setPosition\":{\"title\":\"Let's get to know you\",\"whichDepartment\":\"In which department do you work?\",\"whichRole\":\"What is your role?\",\"done\":\"Done\",\"positionUpdated\":\"Position updated!\",\"other\":\"Other\",\"typeDepartmentHere\":\"Type department here...\",\"options\":{\"customerSupport\":\"Customer Support\",\"hr\":\"HR/People\",\"it\":\"IT\",\"marketing\":\"Marketing\",\"productEngineering\":\"Product/Engineering\",\"operations\":\"Operations\",\"research\":\"Research\",\"sales\":\"Sales\",\"seniorLeader\":\"Senior Leader\",\"manager\":\"Manager\",\"individualContributor\":\"Individual Contributor\"}},\"postPurchaseActivation\":{\"titles\":{\"welcome\":\"Welcome to {subscriptionName}, {firstName}\",\"welcomeBack\":\"Good to see you back, {firstName}\",\"rhythm\":\"You've found your rhythm, {firstName}\"},\"subtitles\":{\"welcome\":\"Start turning conversations into clarity you can act on.\",\"welcomeBack\":\"Discover insights that help you feel prepared and confident in every meeting.\",\"rhythm\":\"Keep building habits that free your focus for the work that matters most.\"},\"titlesTrial\":{\"startStrong\":\"Let's start your free trial strong, {firstName}\",\"momentum\":\"Keep the momentum going, {firstName}\",\"beforeEnd\":\"Before your trial ends, {firstName}\"},\"subtitlesTrial\":{\"startStrong\":\"A couple features people love once they try them:\",\"momentum\":\"Two features people rely on most:\",\"beforeEnd\":\"Give one of these popular features a try:\"},\"recommended\":\"Recommended\",\"exploreMore\":\"Explore more\",\"tutorials\":{\"connectYourCalendarV2\":{\"title\":\"Automatic notes, when you want them\",\"subtitle\":\"Connect your calendar to choose which meetings get notes.\"},\"recordingV2\":{\"title\":\"Capture meetings on-demand\",\"subtitle\":\"Record a conversation any time and turn quick chats into lasting insights.\"},\"enableNotetaker\":{\"title\":\"Your AI {notetakerName}, only where you want it\",\"subtitle\":\"Choose the kinds of meetings you want to send your AI {notetakerName} to.\"},\"import\":{\"title\":\"Past meetings, now transcribed\",\"subtitle\":\"Import audio files to turn past recordings into searchable transcripts.\"},\"sampleSpeech\":{\"title\":\"Automatic summaries and action items\",\"subtitle\":\"Leave every meeting knowing how to turn what's said into what to do.\"},\"meetingTypesTemplateList\":{\"title\":\"The right summary for every meeting\",\"subtitle\":\"Use ready-made or custom templates for structured, consistent meetings.\"},\"playbackV2\":{\"title\":\"Your single source of truth\",\"subtitle\":\"Review recordings with synced transcripts so every word is verified.\"},\"channelsV2\":{\"title\":\"Channels keep you organized\",\"subtitle\":\"Share and group your conversations so your team can find what they need.\"},\"recordingPasteUrl\":{\"title\":\"Record from a video conference link\",\"subtitle\":\"Paste a meeting URL and start capturing any video call with one click.\"}}},\"legacyRecovery\":{\"title\":\"Please update the app\",\"description\":\"A new version is available. Please download the app to continue using it.\",\"download\":\"Download\",\"downloadAriaLabel\":\"Download the latest Otter desktop app\"},\"tutorials\":{\"recordingV2\":{\"step1\":{\"title\":\"Control your recording\",\"desc\":\"Use the pause and stop buttons to manage what gets captured.\"},\"step2\":{\"title\":\"Annotate while recording\",\"desc\":\"Highlight and comment to capture context and call out key moments.\"},\"step3\":{\"title\":\"Share your recording\",\"desc\":\"Give your team a single source of truth for action items and decisions.\"}},\"playbackV2\":{\"step1\":{\"title\":\"Playback controls\",\"desc\":\"Tap the play button to start playback.\"},\"step2\":{\"title\":\"Highlight key moments\",\"desc\":\"Call out moments so you can quickly find them later.\"},\"step3\":{\"title\":\"Ask about your meetings\",\"desc\":\"Get answers or generate content based on all of your conversations.\"}},\"connectYourCalendarV2\":{\"step1\":{\"title\":\"Capture upcoming meetings\",\"desc\":\"Meetings recorded your way, with notes, actions, and decisions captured.\"}},\"channelsV2\":{\"step1\":{\"title\":\"Create a channel\",\"desc\":\"Create a channel to organize conversations by project, team, or recurring meeting.\"}},\"recordingPasteUrl\":{\"step1\":{\"title\":\"Add a meeting\",\"desc\":\"Click the camera icon to record from a video conference link.\"},\"step2\":{\"title\":\"Paste link\",\"desc\":\"Drop your video conference URL into this box.\"},\"step3\":{\"title\":\"Start recording\",\"desc\":\"Press the blue button to confirm and begin recording.\"}},\"meetingTypesTemplateList\":{\"step1\":{\"title\":\"Get the right meeting summary\",\"desc\":\"Create the right summary template to match your meeting format.\"},\"step2\":{\"title\":\"Customize your summaries\",\"desc\":\"Edit any template to focus on what's most important to you and your team.\"}},\"enableNotetaker\":{\"step1\":{\"title\":\"Turn on AI Notetaker\",\"desc\":\"Let it join your video call to transcribe and generate meeting notes.\"}},\"import\":{\"step1\":{\"title\":\"Import recording\",\"desc\":\"Click the Import button to bring in a meeting file for transcription.\"}},\"selfServeCrm\":{\"step1\":{\"title\":\"Enrich your CRM with meeting data\",\"desc\":\"Connect to Salesforce or HubSpot to push important meeting data to your CRM.\"}},\"companyTagsSpeechIntro\":{\"badge\":\"New\",\"title\":\"Companies\",\"desc\":\"Otter automatically adds the company based on the calendar guests, so you can quickly find and chat across related conversations.\"},\"companyFavorite\":{\"desc\":\"Favorite the companies you work with to keep them in your left sidebar.\"},\"chatWorkModes\":{\"step1\":{\"title\":\"Get answers from your tools\",\"desc\":\"Give Otter AI Chat more context by connecting Google Drive, Notion, Gmail, and more.\"},\"step2\":{\"title\":\"Create with Work mode\",\"desc\":\"Work mode uses your connected tools to plan tasks and create finished drafts.\",\"buttonText\":\"Got it\"}}},\"zapierIntro\":{\"imageAlt\":\"Zapier Intro\",\"title\":\"Automate your workflows\",\"description\":\"Use Zapier to connect Otter.ai with 8,000+ apps and automate tasks—no code needed.\",\"bullets\":{\"importRecordings\":\"Import recordings from Dialpad, Twilio, or Zoom Phone\",\"exportSummaries\":\"Export summaries to Google Docs, Notion, or SharePoint\",\"sendActionItems\":\"Send action items to Asana, Jira, or Trello\",\"andMore\":\"And more!\"},\"learnMore\":\"Learn more\",\"tryZapier\":\"Try Zapier for FREE\"},\"languageIntro\":{\"title\":\"{languageName} is now available\",\"description\":{\"line1\":\"Visit the settings page to set this language\",\"line2\":\"as the default for your conversations.\"},\"noThanks\":\"No thanks\",\"openSettings\":\"Open settings\"},\"removedFromWorkspace\":{\"title\":\"Admin removed you from the {workspace} Workspace\",\"description\":\"You have been removed from the {workspace} Workspace and downgraded to a {targetPlan} plan. Your feature limits have been reduced.\",\"contactDescription\":\"Contact the {workspace} Workspace Admin to be re-invited to the Workspace, or \u003cb\u003eupgrade to a {sourcePlan} plan\u003c/b\u003e to remove these limits and create your own Otter Workspace.\",\"planPro\":\"Pro\",\"planBusiness\":\"Business\",\"planBasic\":\"Basic\",\"sourcePlanHeader\":\"{plan} plan limit\",\"targetPlanHeader\":\"{plan} plan limit\",\"monthlyQuota\":\"Monthly quota\",\"transcriptionLimit\":\"Transcription limit\",\"fileImports\":\"File imports\",\"customVocabulary\":\"Custom vocabulary\",\"minutesValue\":\"{count} minutes\",\"hoursValue\":\"{count} hours\",\"importsValue\":\"{count} files (per month)\",\"importsTotal\":\"{count} files (total)\",\"unlimited\":\"Unlimited\",\"vocabPersonal\":\"{count} terms (personal)\",\"vocabTeam\":\"{count} terms (team)\",\"contactAdmin\":\"Contact Workspace Admin\",\"upgrade\":\"Upgrade to {plan}\",\"emailSubject\":\"{name} would like to rejoin the {workspace} Workspace in Otter\",\"emailBody\":\"Hi {removerFirstName},\\n\\nI noticed I no longer have access to the {workspace} Workspace in Otter.ai.\\nI'd like to be re-invited so that I can continue collaborating with my team and using the features available to Workspace members.\\n\\nYou can invite me back to your Workspace from your Otter account by clicking Workspace (under your name) \u003e Invite people to Workspace \u003e then enter my email address.\\n\\nThank you,\\n{name}\"},\"joinTeamOverlay\":{\"title\":\"You've been invited to a workspace\",\"inviteTo\":\"Invite to\",\"memberCount\":\"{count, plural, one {1 member} other {# members}}\",\"managedBy\":\"Managed by\",\"planBusiness\":\"Business\",\"planPro\":\"Pro\",\"planBasic\":\"Basic\",\"leaveAndJoin\":\"Leave {currentWorkspaceName} workspace and join {workspaceName} workspace?\",\"joinWorkspace\":\"Join {workspaceName}?\",\"leavingWorkspaceLegalText\":\"By leaving your workspace, you'll retain ownership of all conversations and channels you currently own.\",\"legalText\":\"By using Otter you agree to the\",\"termsOfService\":\"Terms of Service\",\"andConjunction\":\"and\",\"privacyPolicy\":\"Privacy Policy\",\"tooltipLegaleseInfoLabel\":\"Information: Join new workspace\",\"tooltipLegalese\":\"Any new conversations or channels created within the new workspace will belong solely to that workspace.\",\"decline\":\"Decline invite\",\"joinNow\":\"Join now\",\"downgradeToBasicError\":\"Please downgrade to a Basic plan first in order to join this workspace\",\"declinedInviteSuccess\":\"You have declined the invite to {workspaceName}\",\"errors\":{\"acceptFailed\":\"Unable to join this workspace right now.\",\"declineFailed\":\"Unable to decline this invitation.\"}},\"workspaceInviteLinkOverlay\":{\"defaultWorkspaceName\":\"this workspace\",\"title\":\"You've been invited to a workspace\",\"inviteTo\":\"Invite to\",\"memberCount\":\"{count, plural, one {1 member} other {# members}}\",\"managedBy\":\"Managed by\",\"planBusiness\":\"Business\",\"planPro\":\"Pro\",\"planBasic\":\"Basic\",\"joinWorkspace\":\"Join {workspaceName}.\",\"notNow\":\"Not now\",\"joinNow\":\"Join Now\",\"requestToJoin\":\"Request to Join\",\"invalidToast\":\"This invite link is invalid or has expired.\",\"unusableToast\":\"This invite link could not be used.\",\"alreadyMemberToast\":\"You're already a member of {workspaceName}.\",\"alreadyPendingToast\":\"You've already requested to join {workspaceName}.\",\"joinedToast\":\"You've joined {workspaceName}!\",\"pendingAdminApprovalToast\":\"Your request to join {workspaceName} has been sent for approval.\",\"joinFailedToast\":\"Failed to join workspace. Please try again.\",\"ssoRequiredToast\":\"This workspace requires SSO. Ask a workspace admin to invite you instead of joining from this link.\",\"workspaceConflictBasicOwner\":\"Leave your current workspace before joining this one. Workspace owners must transfer ownership first. Or contact support for further assistance.\",\"workspaceConflictPaidOwner\":\"Please reach out to support for help joining this workspace.\"},\"basicWorkspaceIntro\":{\"title\":\"Welcome to {workspaceName} Workspace\",\"gotIt\":\"Got it\",\"channelsTooltip\":\"Any new conversations or channels created within the new workspace will belong solely to that workspace.\",\"feature0\":{\"title\":\"Supercharge team productivity with AI\",\"description\":\"Get automated meeting notes, action items, and important insights instantly by asking Otter AI Chat.\"},\"feature1\":{\"title\":\"Stay organized with Channels\",\"description\":\"Team conversations are easy to share, archived, and quick to recall. Sharing meeting notes with teammates will invite them to the workspace.\"},\"feature2\":{\"title\":\"Privacy and security compliance\",\"description\":\"Align with global regulatory requirements including SOC 2 TYPE 2, GDPR, CCPA, VPAT, and server-side encryption.\"}},\"salesforceAIChatIntro\":{\"imageAlt\":\"Salesforce Enriched Chat Intro\",\"title\":\"Otter AI Chat + Salesforce\",\"description\":\"Combine meeting insights and Salesforce data to unlock powerful sales intelligence with Otter AI Chat.\",\"features\":{\"naturalLanguageQueries\":\"Drill down into customer accounts with natural language queries\",\"coachableMoments\":\"Highlight coachable moments and track deal progress\",\"dealForecasts\":\"Get AI-powered deal forecasts and identify at-risk opportunities\"},\"reviewSettings\":\"Review settings\",\"tryItNow\":\"Try it now\",\"samplePrompt\":\"What are the 4 biggest deals we won so far in the last quarter? Why did we win them? Anything we can learn?\"},\"calendarConnectEmailTooltip\":{\"desc\":\"Connect your calendar to automatically invite your AI {notetakerName} to every meeting\"},\"notetakerAutoshareEmailTooltip\":{\"desc\":\"Looks like your automatic share setting is not enabled\"},\"desktopPermissions\":{\"autoJoinPrompt\":{\"body\":\"Your {notetakerName} is currently set to join \u003cbold\u003e{currentSetting}\u003c/bold\u003e.\",\"changeSetting\":\"Change setting\"}},\"upsellModal\":{\"title\":\"Upgrade to Otter {planName}\",\"titleTrial\":\"Try Otter Pro For Free\",\"subtitle\":\"Get more from our most loved features.\",\"subtitleTrial\":\"Get more from our most loved features, free for 14 days\",\"featureSearch\":\"Unlimited, fully searchable conversation history\",\"featureRecord\":\"Record up to 90 minutes per conversation\",\"featureRecordBusiness\":\"Record up to 4 hours per conversation\",\"featureTranscription\":\"1,200 transcription minutes and 10 file imports per month\",\"featureTranscriptionBusiness\":\"6000 transcription minutes and unlimited imports\",\"featureChat\":\"Increased AI chat limits, meeting templates\",\"featureIntegrations\":\"Connect to Salesforce, HubSpot, Zapier, and more\",\"price\":\"As low as {price}/mo\",\"teammates\":\"{count, plural, one {# teammate is using Otter.ai} other {# teammates are using Otter.ai}}\",\"ctaUpgrade\":\"Upgrade to Pro\",\"ctaReactivate\":\"Reactivate {plan}\",\"ctaTrial\":\"Try it free for 14 days\",\"planPro\":\"Pro\",\"planBusiness\":\"Business\",\"trialReminder\":\"Cancel anytime, we'll remind you before your trial ends.\",\"maybeLater\":\"Maybe later\"}},\"import-paywall\":{\"title\":\"Import limit reached\",\"subtitle\":\"Get unlimited imports and meetings notes with Business plan.\",\"reasons\":{\"reason1\":\"6000 monthly minutes\",\"reason2\":\"4 hours per conversation\",\"reason3\":\"Unlimited monthly imports\",\"reason4\":\"Unlimited Otter AI Chat\"},\"upgradeAction\":\"Upgrade now\",\"reactivateAction\":\"Reactivate\",\"tryFreeAction\":\"Try Business for free\"},\"upload-quota-info\":{\"trialImportsLeft\":\"{remaining} of {limit} trial imports left\",\"upgradeForUnlimited\":\"Upgrade now for unlimited imports\"},\"upload-file-row\":{\"estimating\":\"Estimating time…\",\"error\":\"Error\",\"done\":\"Done\",\"minutesLeft\":\"{minutes}m left\",\"uploading\":\"Uploading {percent}%\",\"transcribing\":\"Transcribing {percent}%\",\"ellipsis\":\"…\"},\"zoom-connection-settings\":{\"channelShare\":{\"channelPlaceholder\":\"Select a channel name\",\"permissionPlaceholder\":\"Permission\",\"unnamedChannel\":\"Unnamed Channel\",\"permission\":{\"collaborate\":\"Collaborator\",\"view\":\"Viewer\"}},\"cloudSync\":{\"manageTitle\":\"Manage Sync Cloud Recordings\",\"title\":\"Cloud Sync\"},\"liveNotes\":{\"manageTitle\":\"Manage Otter Live Notes\",\"title\":\"Live Notes\",\"tabs\":{\"meetings\":\"Meetings\",\"webinars\":\"Webinars\"}},\"webinar\":{\"title\":\"Schedule live transcription for your webinar\",\"description\":\"Generate webinar codes below to input into your Zoom webinar settings. For step by step instructions see our