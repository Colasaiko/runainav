 Note\",\"subheader\":\"Transcription\",\"speaker\":\"Speaker {speaker_model_label}\",\"unknown_speaker\":\"Unknown Speaker\",\"confirming_speaker\":\"Confirming Speaker...\",\"edit_transcript\":\"Edit transcript\",\"done\":\"Done\",\"saving\":\"Saving...\",\"speaker_assignment\":{\"suggested_speakers\":\"Suggested Speakers\",\"search_or_create_speaker\":\"Search or create speaker\",\"search_speakers\":\"Search speakers\",\"select_speaker\":\"Select speaker\",\"create\":\"Create\",\"tag\":\"Tag\",\"tag_speaker\":\"Tag Speaker\",\"untag\":\"Untag\",\"edit\":\"Edit\",\"save\":\"Save\",\"rename\":\"Rename\",\"hide\":\"Hide\",\"more_options\":\"More options\",\"manage_speakers\":{\"button\":\"Manage Speakers\",\"popover_title\":\"Manage speakers and more\",\"got_it\":\"Got it\",\"popover_body\":\"Merge, delete, or rename Speaker IDs to improve transcript accuracy\"}},\"manage_speakers\":{\"dialog_title\":\"Manage Speakers\",\"dialog_description\":\"Merge duplicates or hide unneeded speakers to improve tagging accuracy. You can also rename speakers.\",\"toast\":{\"merge_success\":\"Speakers merged successfully\",\"merge_error\":\"Failed to merge speakers. Please try again.\",\"unmerge_success\":\"Speakers unmerged successfully\",\"unmerge_error\":\"Failed to unmerge speakers. Please try again.\",\"rename_error\":\"Failed to rename speaker. Please try again.\",\"hide_error\":\"Failed to hide speaker. Please try again.\"},\"button\":{\"cancel\":\"Cancel\",\"confirm_merge\":\"Yes, merge\",\"merge\":\"Merge\",\"merging\":\"Merging...\",\"hide\":\"Hide\",\"undo_merge\":\"Undo merge\",\"unmerge\":\"Unmerge\",\"hide_speaker_tooltip\":\"Hide speaker\"},\"speakers_section\":{\"title\":\"Speakers\",\"tooltip\":\"Speakers represent unique participants across your meetings. Manage them here to update labels across transcripts and improve speaker recognition accuracy.\",\"search_placeholder\":\"Search\",\"loading\":\"Loading speakers...\",\"empty\":\"No speakers\"},\"merge_panel\":{\"select_prompt\":\"Select speakers to merge.\",\"title\":\"Merge into:\",\"choose_speaker\":\"Choose a speaker\",\"change\":\"Change\"},\"confirm\":{\"title\":\"Are you sure?\",\"merge_body\":\"Please review the list and confirm the speakers you want to merge.\",\"hide_title_with_name\":\"Permanently Hide {name}?\",\"hide_detailed_body\":\"Once a speaker is hidden, it can no longer be used to tag a speaker. This will not update the existing transcripts. All speakers merged into this speaker will also be permanently hidden. This action cannot be undone.\",\"unmerge_body\":\"All speakers previously merged into this speaker will be unmerged.\",\"hide_simple_body\":\"Are you sure you want to hide this speaker? This action cannot be undone.\"},\"rename\":{\"placeholder\":\"Rename\",\"rename_tooltip\":\"Rename\",\"save_tooltip\":\"Save\",\"error_required\":\"Name is required\",\"error_max_length\":\"Name must be {count} characters or fewer\"},\"label\":{\"your_otter_account_with_email\":\"{email} (your Otter account)\",\"your_otter_account\":\"Your Otter account\",\"zoom_account_with_email\":\"{email} (From virtual conference apps)\",\"zoom_account\":\"From virtual conference apps\",\"tagged_by_you_with_email\":\"{email} (tagged by you)\",\"tagged_by_you\":\"Tagged by you\",\"merged_with_label\":\"{label} · {count} merged\",\"merged_count\":\"{count} merged\"}},\"unsaved_changes_warning\":\"Are you sure you want to leave? You have unsaved changes in your transcript editing session.\",\"editing_session_timeout\":\"Editing session timed out\",\"transcript_outdated\":\"The transcript is outdated. Please refresh the page to enable editing.\",\"concurrent_editing\":\"An existing editing session is found by another user. Please wait a moment for the user to finish editing.\",\"network_error\":\"Network error. Please try again.\",\"transcript_blocked_by_workspace_admin\":\"Transcript has been blocked by admin\",\"transcript_limit_notice\":{\"title\":\"You've hit the transcription limit\",\"description_can_unlock\":\"You can get the full transcript using your paid plan minutes.\",\"description_upgrade\":\"You've reached the \u003cbold\u003e{limitMinutes} minutes\u003c/bold\u003e per conversation transcription limit. Upgrade to get the full transcript.\",\"description_enterprise\":\"You've reached the \u003cbold\u003e{limitMinutes} minutes\u003c/bold\u003e per conversation transcription limit. Upgrade to Enterprise to get the full transcript.\",\"description_free_owner\":\"You've reached your \u003cbold\u003e{speechLimitMinutes} minutes\u003c/bold\u003e per conversation transcription limit. Upgrade to get the full transcript.\",\"description_workspace_member\":\"You've reached your {limitMinutes} minutes per conversation transcription limit. We have notified the Workspace admin.\",\"description_sharee\":\"This conversation was created with an account that has a {limitMinutes}-minute transcription limit. Ask the owner to upgrade their plan to allow access to the full transcript.\",\"unlock_cta\":\"Unlock full transcript\",\"upgrade\":\"Upgrade\",\"contact_sales\":\"Contact sales\",\"try_free\":\"Try for free\",\"reactivate\":\"Reactivate\",\"request_cta\":\"Request full transcript\",\"request_sent\":\"Request sent\",\"request_pending\":\"Request pending\",\"login_cta\":\"Sign up or log in to request access\",\"processing\":\"Processing...\",\"unlock_failed\":\"Failed to unlock full transcript. Please try again.\",\"request_failed\":\"Failed to send request. Please try again.\"},\"done_editing_toast\":{\"description\":\"Done Editing? Update the summary to match your changes.\",\"alt_text\":\"Regenerate Summary\",\"update_button\":\"Update\"},\"summary_regeneration\":{\"success_message\":\"Summary is regenerating, please check back in a few minutes.\",\"success_alt_text\":\"Regenerate success\",\"ai_edit_in_progress\":\"AI is editing the summary. Try again when it finishes.\",\"canvas_unavailable\":\"Summary editing is temporarily unavailable. Try again shortly.\"},\"image\":{\"interactive_image_preview\":\"Interactive Image Preview\",\"meeting_screenshot_number\":\"{value} screenshot of the meeting\",\"download_image\":\"Download image\",\"previous_image\":\"Previous Image\",\"next_image\":\"Next image\",\"viewing_details\":\"Viewing {index, number} of {total, number}\",\"delete_image\":\"Delete image\",\"deleteImageModal\":{\"title_message\":\"Are you sure you want to delete the image?\",\"warning\":\"Deleted image cannot be recovered.\"},\"live_screenshot\":{\"live_slide_updates\":\"Live Slide updates every 10 seconds\",\"automatic_slide_capture\":\"Automatic Slide Capture\",\"slide_capture\":\"Slide Capture\",\"more_options\":\"More options\",\"close_viewer\":\"Close live screenshot viewer\",\"capture_slide\":\"Capture slide image\",\"capture\":\"Capture\",\"close\":\"Close\",\"live_preview_alt\":\"Live screenshot preview\",\"live_shared_screen_alt\":\"Live shared screen\",\"view_live_screenshot\":\"View live screenshot\",\"otter_added_screenshot\":\"Otter added a screenshot\",\"image_added\":\"Image added\",\"capture_failed\":\"Failed to capture screenshot\",\"image_deleted\":\"Image deleted\",\"auto_snapshot_error\":\"Unable to update automatic slide capture.\"}},\"user_log_in_required\":\"User is not logged in. Please login to continue.\",\"scroll_current_position\":\"Scroll to current position\",\"scroll_current_timestamp\":\"scroll to current timestamp\",\"realigning_text_with_audio\":\"Realigning text with audio\",\"show_only_highlights\":\"Show only highlights\",\"export_all_highlights\":\"Export all highlights\",\"feedback\":{\"how_accurate_transcription\":\"How accurate was this transcription?\",\"rate_transcription_title\":\"How would you rate this transcription?\",\"cancel\":\"Cancel\",\"submit_feedback\":\"Submit feedback\",\"tell_us_more_placeholder\":\"Tell us more (optional)\",\"permission_checkbox_user\":\"Allow Otter and its third-party service provider(s) permission to access my conversations for training and product improvement, including through human review.\",\"permission_disclaimer_user\":\"This helps our services become more useful and accurate. You can change your preference in account settings. See our \u003clink\u003ePrivacy Policy\u003c/link\u003e for more details.\",\"permission_checkbox_conversation\":\"Allow Otter and its third-party service provider(s) permission to access this conversation for training and product improvement, including through human review.\",\"permission_disclaimer_conversation\":\"This helps our services become more useful and accurate. Otter respects your privacy. See our \u003clink\u003ePrivacy Policy\u003c/link\u003e for more details.\"}},\"meeting_chat\":{\"ask_ai_questions\":\"Ask AI questions or\",\"chat_with_teammates\":\"chat with your teammates\",\"ask_about_conversations\":\"  Ask anything about your conversations...\",\"new_suggestions\":\"New suggestions\",\"send_message\":\"Send message\"},\"outline\":{\"expand\":\"Expand\",\"collapse\":\"Collapse\",\"copy_outline\":\"Copy outline\",\"copy_link\":\"Copy link\",\"edit\":\"Edit\",\"useful\":\"Useful\",\"not_useful\":\"Not useful\",\"undo_useful\":\"Undo 'Useful'\",\"undo_not_useful\":\"Undo 'Not useful'\",\"rate_summary_question\":\"How would you rate this summary?\",\"placeholder\":{\"empty_alt\":\"No outline\",\"empty\":{\"title\":\"No outline yet\",\"description\":\"Summarized key points will appear here after the meeting, if there's enough content to outline.\"},\"uninitiated\":{\"description\":\"Automated summary will appear here after the meeting is finished\"},\"skip\":{\"title\":\"This was a quick conversation!\",\"description\":\"Summaries are generated for longer meetings\"},\"processing\":{\"title\":\"Automated summary will be ready soon\",\"bullets\":{\"navigate\":\"Navigate quickly to what's important\",\"recap\":\"Get a recap of what was talked about\"}}},\"toast\":{\"outline_copied\":\"Outline copied to clipboard\",\"outline_copy_failed\":\"Failed to copy outline\",\"link_copied\":\"Outline link copied to clipboard\",\"link_copy_failed\":\"Failed to copy outline link\"}},\"media_control_bar\":{\"seek_slider_accessibility_label\":\"Seek slider\",\"current_time_seconds\":\"we are at {time} seconds\",\"audio_deleted_due_to_workspace_data_retention\":\"Audio deleted due to workspace data retention\",\"audio_removed_by_workspace_admin\":\"Audio removed by Workspace Admin\",\"processing_audio\":\"Processing audio...\",\"playback_bar\":{\"rewind_button_label\":\"Rewind 5 seconds\",\"pause_button_label\":\"Pause audio\",\"play_button_label\":\"Play audio\",\"forward_button_label\":\"Fast forward 5 seconds\"},\"playback_settings\":{\"upgrade\":\"Upgrade\",\"playback_options_cta\":\"to unlock more playback speeds.\",\"playback_cta_basic_workspace_member\":\"Contact workspace admin\",\"login_cta\":\"Playback is set to 1x. Paid subscribers can log in to access more playback speeds.\",\"playback_options\":\"Playback Options\",\"speed\":\"Speed\",\"skip_silence\":\"Skip Silence\"}},\"sales_coach\":{\"emptyState\":{\"live\":\"Coaching will appear once the meeting starts\",\"ended\":\"Looks like there weren't any suggestions!\"},\"popOut\":\"Pop out\",\"rating\":{\"question\":\"How were the suggestions?\",\"responses\":{\"1\":\"We appreciate the honesty.\",\"2\":\"That's fair.\",\"3\":\"Room for improvement!\",\"4\":\"Good is almost great.\",\"5\":\"You're too kind.\"},\"placeholders\":{\"1\":\"Would you elaborate?\",\"2\":\"How could it be better?\",\"3\":\"What would you improve?\",\"4\":\"What's missing?\",\"5\":\"What do you like about it?\"},\"done\":\"Done\",\"thankYou\":\"Thanks for the feedback!\"},\"cardRating\":{\"helpful\":\"Helpful\",\"notHelpful\":\"Not helpful\",\"unhelpful\":\"Unhelpful\"}},\"live_assist\":{\"default_agent_name\":\"Live Assist\",\"owner_only\":\"Live Assist is only available to {speech_owner_name}, the owner of this speech.\",\"pop_out_aria_label\":\"Pop out\",\"settings_aria_label\":\"Live Assist settings\",\"settings_menu_item\":\"Live Assist settings\",\"no_objectives_found\":\"No objectives found\",\"auto_tips_on\":\"Automatic tips are on. Suggestion cards may appear throughout your call\",\"auto_tips_off\":\"Automatic tips are off. You can turn them back on anytime\",\"auto_tips_button_label\":\"Auto tips\",\"next_tip_button_label\":{\"is_generating\":\"Generating\",\"is_not_generating\":\"Next tip\"},\"error_toast\":{\"action\":{\"generate\":\"Error generating next tip\",\"disable\":\"Error disabling auto tips\",\"enable\":\"Error enabling auto tips\",\"start\":\"Error starting live assist\",\"reload\":\"Error switching live assist agent\",\"objective_update\":\"Failed to update objective status.\"}},\"landing_page\":{\"image_alt\":\"Live Assist\",\"agent_label\":\"Agent: {agentName}\",\"start_session\":\"Turn on Live Assist\",\"open_agent_builder\":\"Open Agent Builder\"},\"agent_selector\":{\"dropdown_title\":\"Live assist agents\",\"owned_by_you\":\"Owned by you\",\"owned_by_name\":\"Owned by {ownerName}\",\"owned_by_unknown\":\"Owned by unknown\"},\"objectives\":{\"actions_aria_label\":\"Objective actions\",\"mark_as_complete\":\"Mark as complete\",\"mark_as_incomplete\":\"Mark as incomplete\"}},\"sidebar_tabs\":{\"ai_chat\":\"AI Chat\",\"outline\":\"Outline\",\"comments\":\"Comments\",\"coach\":\"Live Assist\"},\"sidebar_aria_label\":\"Conversation Sidebar\",\"live_viewers\":{\"viewer_name_you\":\"{name} (you)\",\"anonymous_user\":\"Anonymous user\",\"total_viewers\":\"{count} total viewers\"},\"blocked\":{\"summary\":\"Summary has been blocked by the speech owner's workspace admin\",\"transcript\":\"Transcript has been blocked by the speech owner's workspace admin\",\"transcript_data_retention\":\"Transcript deleted due to workspace data retention\"},\"low_confidence\":{\"description\":\"Low audio quality detected. \u003clink\u003eLearn more\u003c/link\u003e about how to improve transcription quality.\"},\"processing_status\":{\"processing\":\"Processing conversation...\",\"process_failed_title\":\"Invalid or corrupted file\",\"process_failed_subtitle\":\"Please check file and import again\"},\"public\":{\"transcript_disabled\":\"Live transcript is disabled\"},\"video\":{\"processing\":\"Video is still processing.\",\"refresh_button\":\"Refresh\",\"refresh_hint\":\"in 10 - 30 minutes.\"},\"language_reprocessing\":{\"reprocessing_in_progress\":{\"title\":\"Reprocessing transcript\",\"description\":\"Reprocessing your transcript. This may take a few minutes.\"},\"unsupported_language\":{\"title\":\"Unsupported language\",\"description\":\"Your account language is set to {userLanguage}, but this meeting appears to be in an unsupported language. Transcription isn't available for this language.\",\"see_supported_languages\":\"See supported languages\"}},\"change_language_modal\":{\"title\":\"Change language\",\"title_default\":\"Change default language\",\"update_language\":\"Update language\",\"description\":\"The language you select will be applied to this transcript and all your future meetings.\",\"live_description\":\"Select the language you want this meeting transcribed in.\",\"live_title\":\"Language setting\",\"live_readonly_info\":\"You can change language and reprocess the conversation after recording ends. Click the \\\"...\\\" button on the conversation page after this meeting.\",\"default_language\":\"Default language\",\"select_language\":\"Select a language\",\"live_info_line_1\":\"You won't see the transcript reflect the new language until the meeting ends and processing is complete. This will also apply to future recordings.\",\"reprocessing_info_line_1\":\"For this transcript, the change will only apply when it matches the audio language.\",\"reprocessing_info_line_2\":\"If the transcript is being reprocessed, the new change will apply after the current reprocessing is completed.\",\"success_toast\":\"Language updated successfully\",\"error_toast\":\"Failed to update language\",\"reprocessing_error_toast\":\"Failed to update language from reprocessing\"},\"notes\":{\"copy\":\"Copy\",\"copied\":\"Copied to clipboard\",\"copy_failed\":\"Could not copy notes\",\"save_failed\":\"Notes could not be saved. Try again.\",\"reenhance\":\"Re-enhance\",\"expand_to_overview\":\"Expand to overview\",\"generate_full_overview\":\"Generate full overview with your notes\",\"overview_title\":\"Overview with your notes\",\"only_visible_to_you\":\"Only visible to you\",\"enhancing\":\"Enhancing your notes…\",\"expanding\":\"Expanding to overview…\",\"enhanced_empty\":\"Enhanced notes will appear here after your meeting ends, or you can generate them now.\",\"overview_empty\":\"Merge your notes with the meeting context into a private overview.\",\"placeholder_live\":\"Take notes during the meeting...\",\"placeholder_raw\":\"Take notes...\",\"placeholder_enhanced\":\"Edit your enhanced notes...\",\"placeholder_overview\":\"Edit your overview...\",\"caption_enhanced\":\"AI enhanced notes. Only visible to you.\",\"caption_raw\":\"Your raw notes. Only visible to you.\",\"mode\":{\"enhanced\":\"Enhanced\",\"raw\":\"Raw\",\"overview\":\"Overview\"},\"mode_slider_label\":\"Notes view\",\"generate\":{\"enhanced_started\":\"Enhancing your notes…\",\"overview_started\":\"Expanding to overview…\",\"error\":\"Something went wrong. Try again.\"},\"reenhance_modal\":{\"title\":\"Re-enhance notes?\",\"body\":\"Enhancement uses your raw notes. Changes you made to enhanced notes will be lost.\",\"body_with_overview\":\"Enhancement uses your raw notes. Changes you made to enhanced notes and overview will be lost.\",\"cancel\":\"Cancel\",\"confirm\":\"Re-enhance\"}}},\"unified-canvas\":{\"living_page_sidebar_aria_label\":\"Living Page Sidebar\",\"mermaid\":{\"rendering\":\"Rendering diagram...\",\"render_error\":\"Couldn't render this diagram. Here's its source:\"},\"chart\":{\"rendering\":\"Rendering chart...\",\"render_error\":\"Couldn't render this chart. Here's its data:\"},\"image\":{\"loading\":\"Loading image…\",\"load_error\":\"This image could not be loaded.\"},\"link\":{\"label\":\"Link\",\"placeholder\":\"Paste or type a link…\"},\"insert\":{\"label\":\"Insert\",\"block\":\"Insert block\",\"button\":\"Button\",\"table\":\"Table\"},\"mention\":{\"local_time_theirs\":\"{time} local time\",\"local_time_theirs_hint\":\"Current time for {name}\",\"local_time_yours\":\"{time} your time\",\"local_time_yours_hint\":\"We don’t know where {name} is yet, so this is your own time zone\",\"has_access\":\"Has access\",\"share\":\"Share\",\"share_error\":\"We couldn’t share the page with them.\",\"notify\":\"Notify\",\"notify_hint\":\"Notifying people from a page is coming soon\"},\"editingIntro\":{\"badge\":\"NEW\",\"title\":\"Your summary is now editable\",\"subtitle\":\"Rewrite it with AI, or edit it like a doc.\",\"demoCaption\":\"Select text → Ask AI → rewritten\",\"row1Lead\":\"Ask AI to edit anything.\",\"row1Body\":\" Select text or hit / to ask AI — rewrite, shorten, expand, or reformat.\",\"row2Lead\":\"Or ask AI Chat for bigger edits.\",\"row2Body\":\" Mention this meeting: \\\"turn the action items into a table,\\\" \\\"add a TLDR at the top.\\\"\",\"row3Lead\":\"Or just type.\",\"row3Body\":\" # headings, - bullets, [ ] to-dos. Drag blocks to reorder.\",\"cta\":\"Try an AI edit\",\"aiEditPrefillPrompt\":\"Revise the summary so that\",\"demoOverview\":\"Overview\",\"demoSentenceOriginal\":\"The team agreed to \u003cmark\u003epush the launch back by two weeks, since the vendor integration still needs to clear a full QA sign-off before we can roll it out to customers\u003c/mark\u003e.\",\"demoSentenceRevised\":\"The team agreed to \u003cmark\u003edelay the launch two weeks for QA\u003c/mark\u003e.\",\"demoAskAi\":\"Ask AI\",\"demoPlaceholder\":\"Edit or ask with AI…\",\"demoRewriteGroup\":\"Rewrite\",\"demoRowSimplify\":\"Simplify language\",\"demoRowShorter\":\"Make it shorter\",\"demoRowLonger\":\"Make it longer\"}},\"desktop-download\":{\"title\":\"Thanks for downloading! Just a few steps left.\",\"description\":\"Your download will begin automatically. If it didn’t start,\",\"manualDownload\":\"download Otter manually.\",\"otterLogoAlt\":\"Otter.ai\",\"steps\":{\"clickDownloadAlt\":\"Open the Otter installer from Downloads\",\"dragDownloadAlt\":\"Drag Otter into the Applications folder\",\"openDownloadAlt\":\"Open Otter from the Applications folder\",\"openMac\":\"Open otter.dmg from your Downloads folder.\",\"openWindows\":\"Open otter.exe from your Downloads folder.\",\"dragMac\":\"Drag the Otter icon into your Applications folder.\",\"dragWindows\":\"Follow the installer prompts.\",\"openAppMac\":\"Open Otter from your Applications folder.\"}},\"recording\":{\"banners\":{\"download_desktop_cta\":\"Download desktop app →\",\"first_time\":{\"icon_text\":\"Tip\",\"description\":\"Want to capture more reliable, higher-quality audio? Keep this tab open and your computer awake to avoid interruptions. But if you're using headphones, web recording will only capture your mic. Use Otter for desktop to record everyone's audio.\"},\"repeat\":{\"title\":\"Try Otter for desktop\",\"description\":\"Get higher-quality audio, system audio capture, and more reliable recordings with the Otter desktop app.\"},\"headphone_detection\":{\"title\":\"Using headphones?\",\"description\":\"Browser recordings capture microphone audio only. Headphones prevent other voices from being recorded. Use the \u003clink\u003eOtter desktop app\u003c/link\u003e to capture both microphone and system audio.\"},\"offline\":{\"title\":\"You're offline\",\"description\":\"Recording continues, but transcription is paused until you reconnect.\"},\"network_slow\":{\"title\":\"Slow network connection.\",\"description\":\"You may see transcription lag, but Otter is still recording.\"},\"no_audio\":{\"title\":\"No audio is being captured\",\"hint_muted\":\"- Check that your microphone isn't muted\",\"hint_headphones\":\"- If using headphones, try your device's built-in mic instead\",\"hint_permissions\":\"- Verify Otter has microphone permissions\",\"troubleshoot\":\"If the issue continues, visit \u003chelp-link\u003eTroubleshooting\u003c/help-link\u003e\"},\"tab_freeze\":{\"description\":\"Your computer went into sleep mode during the recording, which may have resulted in the loss of part of the audio.\"},\"post_recording\":{\"headphone\":{\"title\":\"Headphones detected during recording\",\"description\":\"You were wearing headphones during the recording. If you were recording an online meeting, meeting participants' audio would not be captured while wearing headphones.\"},\"offline\":{\"title\":\"Connection issues during recording\",\"description\":\"Your internet experienced some connection issues during the recording, which may have resulted in the loss of part of the audio.\"},\"tab_freeze\":{\"description\":\"Your computer went into sleep mode during the recording, which may have resulted in the loss of part of the audio.\"},\"no_proper_stop\":{\"description\":\"Your recording was ended by closing the browser, which may have resulted in an incomplete recording.\"},\"audio_recovery\":{\"title\":\"Recovered audio available\",\"description\":\"Some of your audio wasn't uploaded successfully, but we were able to recover it. Retry the upload to restore the missing audio.\",\"cta_text\":\"Retry upload\"}}},\"adhoc_recording\":{\"record_in_channel_confirm\":{\"title\":\"Record in channel?\",\"message\":\"This will make the recording visible to all channel members.\"},\"start_button_label\":\"Record\",\"pause_button_label\":\"Pause recording\",\"pause_button_label_short\":\"Pause\",\"stop_button_label\":\"Stop recording\",\"stop_button_label_short\":\"Stop\",\"resume_button_label\":\"Resume recording\",\"resume_button_label_short\":\"Resume\",\"expand_button_label\":\"Open recording\",\"manual_recording_disabled_tooltip\":\"Manual recording has been disabled by your workspace admin\",\"mute_button\":{\"label\":\"Mute\",\"tooltip\":\"Mute mic, record only system audio\"},\"unmute_button\":{\"label\":\"Unmute\",\"tooltip\":\"Unmute mic, record both mic and system audio\"},\"mic_switcher\":{\"label\":\"Select a microphone\",\"unknown_device_label\":\"Unknown\"},\"language_indicator\":{\"caption\":\"This meeting is being transcribed in {language}\"},\"auto_scroll_label\":\"Scroll to current play position\",\"hightlight_label\":\"Highlight\",\"comment_label\":\"Comment\",\"add_image_label\":\"Add image\",\"transcript\":{\"transcript_blocked_label\":\"The meeting is recording...\"},\"toasts\":{\"audio_device_connection\":\"Connecting to: {deviceLabel}\",\"audio_device_connection_unknown\":\"Unknown Device\",\"start_recording_fail\":\"Whoops, something went wrong... Please reload the page and try again.\",\"start_recording_fail_desktop\":\"Whoops, something went wrong... Please try again.\",\"internal_start_recording_fail_desktop\":\"Recording failed to start. Please restart the app and try again.\",\"internal_resume_recording_fail_desktop\":\"Recording failed to resume. Please restart the app and try again.\",\"create_recording_fail\":\"Otter cannot connect to the server. Please try again later.\",\"recording_ended_in_error\":\"The recording ended unexpectedly due to an error... Please try again.\",\"desktop_compatibility_error\":\"Recording on Otter requires macOS 15+. Please update your system.\",\"mic_permission_denied\":\"Otter needs permission to access the microphone in order to work. Please go to your browser's settings to grant microphone permission to Otter.\",\"transcript_limit_reached\":\"Transcript limit reached.\",\"recording_consent\":\"Always ask permission before recording.\",\"missing_required_email_for_dm\":\"Email address is required for DM recording.\",\"fetch_calendar_meeting_fail\":\"Failed to retrieve calendar meeting. Please try again.\",\"retry_offline_sample_start_failed\":\"Unable to process request. Please try again later.\",\"retry_offline_sample_started\":\"Uploading audio... Please do not close this tab.\",\"retry_offline_sample_failed\":\"Upload failed. Please try again.\",\"retry_offline_sample_success\":\"Upload complete. Processing audio... Please check back in 30 minutes.\",\"cross_tab_audio_permission_pending\":\"Otter needs permission to access the microphone. Please return to your recording tab and allow microphone access when prompted.\",\"recording_saved\":{\"message\":\"Recording saved in {locationName}\",\"default_location_name\":\"My Conversations\"}},\"warnings\":{\"network_offline\":{\"title\":\"No network connection.\",\"message\":\"You may see transcription stop, but Otter is still recording.\",\"troubleshootUrl\":\"\"},\"network_slow\":{\"title\":\"Slow network connection.\",\"message\":\"You may see transcription lag, but Otter is still recording.\",\"troubleshootUrl\":\"\"},\"no_sound\":{\"title\":\"Not recording?\",\"message\":\"If your meeting has started but your Otter notes are not transcribing the conversation, there might be an issue with the audio input. Unplug any headphones or audio cables to make sure your computer or mobile device's microphone receives the audio from your meeting. If the problem continues, visit \u003chelp-link\u003eTroubleshooting audio problems\u003c/help-link\u003e\"},\"no_sound_desktop\":{\"title\":\"Speech not detected\",\"message\":\"If you are speaking, please check your default microphone\"},\"recording_not_supported\":{\"title\":\"Browser not supported\",\"warning\":\"Recording is not supported for this browser\",\"message\":\"The otter.ai website currently works best with Google Chrome (desktop layout). For additional assistance please visit our \u003chelp-link\u003eHelp Center\u003c/help-link\u003e\",\"helpLink\":\"https://help.otter.ai/hc\"}},\"s3_upload\":{\"failure\":{\"title\":\"Upload failed\",\"subtitle\":\"Would you like to download the recording to your device?\",\"message\":\"You can then import the file into Otter\",\"retry_bu